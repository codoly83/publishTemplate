# API Configuration
# Set to 'true' to use MSW mock API, 'false' to use real backend
VITE_USE_MOCK_API=true

# API base path (relative path, proxied by Vite in dev)
VITE_API_BASE_URL=/api

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# Backend server URL (Vite proxy target when using real backend)
VITE_BACKEND_URL=http://localhost:8080
